# ---------- Banco ----------
# Postgres. No Railway, adicione um serviço Postgres e referencie a variável que
# ele expõe (${{Postgres.DATABASE_URL}}) em vez de colar a string na mão — assim
# ela acompanha sozinha qualquer troca de credencial.
#
# A porta 6543 é convenção de pooler (pgBouncer): o código detecta e desliga o
# pool próprio do SQLAlchemy, que senão conflita. O Neon atende na 5432.
DATABASE_URL=postgresql://usuario:senha@host:5432/neondb?sslmode=require

# ---------- Acesso ----------
# As contas vivem no banco, não aqui. Crie e troque senha com:
#
#     uv run python -m app.criar_usuario
#
# Ele pede a senha escondida e grava só o hash Argon2id — a senha em si não
# existe em arquivo nenhum do sistema.

# Segredo que assina os tokens de TODAS as contas. Este é do servidor, não de
# uma pessoa, e é segredo de verdade: quem tiver ele emite acesso sem precisar
# de senha nenhuma. Trocá-lo desconecta todo mundo.
SENTAVOS_JWT_SECRET=

# ---------- Só na migração para multiusuário ----------
# Estas duas existiam quando o app tinha uma conta só. A migração 0001 lê elas
# pra saber a quem pertencem as linhas que já estavam no banco, e cria essa
# primeira conta. Depois que a migração rodar, podem ser removidas do host.
# SENTAVOS_EMAIL=voce@exemplo.com
# SENTAVOS_SENHA_HASH=
# SENTAVOS_NOME=Seu Nome

# ---------- Opcional ----------
# Origens liberadas no CORS, separadas por vírgula. Em produção, o domínio do
# front. O padrão cobre localhost em dev.
# CORS_ORIGINS=https://sentavos.vercel.app

# Botão de "desconectar tudo". Timestamp Unix: token emitido antes dele para de
# valer. Use se um aparelho sumir ou a senha vazar — é o que substitui uma lista
# de sessões, que este app não tem de propósito.
# Pra pegar o instante atual: python -c "import time; print(int(time.time()))"
# SENTAVOS_TOKEN_EPOCH=

# Teto de requisições por IP por minuto. O padrão (240) é folgado pra uso humano
# — abrir uma aba dispara várias chamadas — e apertado pra script varrendo a API.
# RATE_LIMIT_POR_MINUTO=240

# Teto de respostas 401/403 por IP a cada 5 minutos. Esta é a cota que torna
# "tentar senha até acertar" inviável. Baixo de propósito: uso legítimo quase
# nunca produz credencial recusada.
# RATE_LIMIT_FALHAS=10

# DOCS_ABERTOS=1 religa /docs, /redoc e /openapi.json, que ficam desligados por
# padrão. Eles não expõem dado, mas entregam o mapa completo da API pra quem só
# tem a URL. Ligue pra depurar, desligue depois.
# DOCS_ABERTOS=0

# SQL_ECHO=1 loga todo SQL com os valores. Use pra depurar, nunca em produção:
# enche o log do host e joga dado financeiro nele.
# SQL_ECHO=0
