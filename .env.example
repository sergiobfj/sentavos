# ---------- Banco ----------
# Postgres do Supabase. A porta 6543 é o pooler (pgBouncer), recomendada pra
# app hospedado; a 5432 é conexão direta. O código detecta a 6543 e desliga o
# pool próprio do SQLAlchemy, que senão conflita com o pooler.
DATABASE_URL=postgresql://usuario:senha@host:6543/postgres

# ---------- Autenticação ----------
# URL do projeto (a mesma do VITE_SUPABASE_URL). A API busca nela a chave pública
# que verifica a assinatura do token: {SUPABASE_URL}/auth/v1/.well-known/jwks.json
#
# Projeto Supabase novo assina com ES256 (par de chaves, pública no JWKS). Sem
# esta variável, só o caminho HS256 abaixo funciona — e aí todo token real é
# recusado com 401.
SUPABASE_URL=https://seu-projeto.supabase.co

# Painel do Supabase > Settings > API > JWT Secret. Só serve pra projeto que
# ainda usa o esquema legado HS256; quem já está em ES256 pode deixar vazio.
# Se estiver preenchido, trate como senha: quem tem ele forja acesso.
SUPABASE_JWT_SECRET=

# O id (UUID) da única conta que pode usar o app. Painel do Supabase >
# Authentication > Users > coluna UID.
#
# Isto não é firula: se o seu projeto Supabase estiver com cadastro aberto,
# qualquer pessoa cria uma conta e recebe um token com assinatura válida. É o
# sub bater com este valor que separa você de todo mundo. Sem esta variável a
# API recusa tudo (falha fechada) em vez de liberar.
SENTAVOS_ALLOWED_USER_ID=

# ---------- Opcional ----------
# Origens liberadas no CORS, separadas por vírgula. Em produção, o domínio do
# front. O padrão cobre localhost em dev.
# CORS_ORIGINS=https://sentavos.seudominio.com

# SQL_ECHO=1 loga todo SQL com os valores. Use pra depurar, nunca em produção:
# enche o log do host e joga dado financeiro nele.
# SQL_ECHO=0

# ---------- Limites e blindagem ----------
# Teto de requisições por IP por minuto. O padrão (240) é folgado pra uso humano
# — abrir uma aba dispara várias chamadas — e apertado pra script varrendo a API.
# RATE_LIMIT_POR_MINUTO=240

# Teto de respostas 401/403 por IP a cada 5 minutos. Esta é a cota que torna
# "tentar token até acertar" inviável. Baixo de propósito: uso legítimo quase
# nunca produz credencial recusada.
# RATE_LIMIT_FALHAS=10

# DOCS_ABERTOS=1 religa /docs, /redoc e /openapi.json, que ficam desligados por
# padrão. Eles não expõem dado, mas entregam o mapa completo da API pra quem só
# tem a URL. Ligue pra depurar, desligue depois.
# DOCS_ABERTOS=0
