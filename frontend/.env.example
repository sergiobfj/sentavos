# URL da API FastAPI. Em dev, o backend roda em http://localhost:8000
VITE_API_URL=http://localhost:8000

# Supabase Auth. Painel do projeto > Settings > API.
# A anon key é pública por design: ela vai no bundle que o navegador baixa. O
# que protege os dados é a API validar o JWT, não essa chave ser secreta.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
